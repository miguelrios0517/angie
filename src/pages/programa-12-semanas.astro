---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayoutAngie.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Servicios"
    title="Programa de Transformación (12 Semanas)"
    subtitle="Un proceso de 3 meses para reconectar contigo, regular tu mente y expandir tu potencial"
    actions={[{ variant: 'primary', text: 'Explorar servicio', href: '/programa-12-semanas#intro' }]}
    image={{
      src: 'https://assets.angiewongpsi.com/father_son.jpg',
      alt: 'Father and son drinking coffee',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    id="intro"
    isReversed
    image={{
      src: 'https://assets.angiewongpsi.com/individual_computer.jpg',
      alt: 'Woman on her computer',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Tu Laboratorio de Transformación Profunda desde Casa
      </h3>
      <p>
        ¿Sientes que vives apagando problemas emocionales, atrapado en el estrés y el autosabotaje? Aunque la terapia
        tradicional ayuda a comprender tu historia, este programa está diseñado para ir más allá de la comprensión.<br
        /><br />
        Este proceso integra enfoque clínico, neuro-reprogramación y trabajo somático. No se trata solo de entender lo que
        te pasa, sino de entrenar tu sistema interno para generar cambios reales, medibles y sostenibles desde casa.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Funcionas en automático',
        description: 'Sientes que los días pasan sin dirección clara ni control real.',
        icon: 'tabler:clock',
      },
      {
        title: 'Mente saturada',
        description: 'Ansiedad, sobrepensamiento o autosabotaje interfieren con tus decisiones.',
        icon: 'tabler:school',
      },
      {
        title: 'Estás en un cambio de etapa',
        description: 'Ruptura, transición o crisis personal que requiere orden interno.',
        icon: 'tabler:coin',
      },
      {
        title: 'Quieres algo que sí se sostenga',
        description: 'Has probado soluciones rápidas que no generan cambios duraderos.',
        icon: 'tabler:file-download',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/hiking_cropped.jpg',
      alt: 'A woman hiking',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">¿Es este programa para ti?</h3>
      <p>
        Este programa no trabaja con soluciones superficiales. Está diseñado para un cambio profundo. Probablemente te
        identifiques si:
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    title="La Estructura del Programa"
    subtitle="Un proceso de 12 sesiones individuales de 50 minutos basado en psicología clínica, neurociencia y trabajo somático para generar transformación progresiva y medible."
    isReversed
    items={[
      {
        title: 'Mapeo emocional y conductual',
        description:
          'Analizamos áreas clave de tu vida y observamos tu respuesta fisiológica al estrés mediante tu smartwatch.',
        icon: 'tabler:wand',
      },
      {
        title: 'Exploración de origen interno',
        description:
          'Accedemos a patrones inconscientes y familiares a través de relajación guiada e Hipnosis Ericksoniana.',
        icon: 'tabler:settings',
      },
      {
        title: 'Reprogramación de creencias',
        description:
          'Identificamos pensamientos limitantes y los reestructuramos con PNL para reducir su impacto emocional.',
        icon: 'tabler:presentation',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/individual_phone.jpg',
      alt: 'A man using his cellphone',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Primer Mes: Claridad y evaluación interna
      </h3>
      <p>
        Fase para entender tu sistema mental, detectar bloqueos y medir estrés real (Mapeo, Hipnosis Ericksoniana, PNL).
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Regulación del sistema nervioso (EFT)',
        description: 'Aprendes técnicas de tapping para reducir activación emocional de forma rápida y medible.',
        icon: 'tabler:clock',
      },
      {
        title: 'Procesamiento del pasado (Línea del Tiempo)',
        description:
          'Revisamos experiencias clave para liberar carga emocional y conservar el aprendizaje con la terapia Time Line Therapy®.',
        icon: 'tabler:school',
      },
      {
        title: 'Integración y seguridad interna',
        description:
          'Resolución de conflictos internos y creación de anclajes físicos para activar calma y estabilidad.',
        icon: 'tabler:coin',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/mom_daughter_hug.jpg',
      alt: 'Mom and daughter hugging',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Segundo Mes: Liberación emocional y reorganización interna
      </h3>
      <p>
        Proceso para liberar carga emocional y reentrenar la respuesta del sistema nervioso (EFT, Time Line Therapy®).
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    isReversed
    items={[
      {
        title: 'Reprogramación de identidad',
        description: 'Hipnosis clínica para reforzar autoconfianza, estabilidad emocional y autoestima.',
        icon: 'tabler:clock',
      },
      {
        title: 'Sostenimiento del cambio',
        description: 'Rutinas simples de respiración y coherencia cardíaca para mantener regulación emocional.',
        icon: 'tabler:school',
      },
      {
        title: 'Dirección futura clara',
        description:
          'Definición de objetivos a 5 años con visualización guiada + audio personalizado de refuerzo nocturno.',
        icon: 'tabler:coin',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/group_jumping.jpg',
      alt: 'Group jumping',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Tercer Mes: Consolidación y nueva identidad
      </h3>
      <p>
        Fase final para integrar cambios y diseñar tu siguiente etapa (Hipnosis, coherencia cardíaca, audio guiado).
      </p>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Lo que dicen quienes ya han dado el paso"
    testimonials={[
      {
        testimonial: `El proceso con Angie ha sido transformador. Sus herramientas prácticas de PNL realmente me ayudaron a superar la tensión constante que afectaba mi día a día. Ahora me siento empoderada y capaz de manejar los desafíos de una manera muy saludable.`,
        name: 'Valeria Mendoza',
        job: 'Mentees Satisfecha',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Cary Kennedy Image',
        },
      },
      {
        testimonial: `Como coach, Angie me guio a través de un process de autorreflexión que cambió mi perspectiva y me dio el impulso necesario para avanzar en mi carrera. Su apoyo fue fundamental para alcanzar mis metas profesionales.`,
        name: 'Carlos Espinoza',
        job: 'Cliente Profesional',
        image: {
          src: 'https://images.unsplash.com/flagged/photo-1570612861542-284f4c12e75f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Josh Wilkinson Image',
        },
      },
      {
        testimonial:
          'Gracias a las sesiones de claridad y enfoque con Angie, finalmente pude tomar decisiones informadas sobre mi futuro académico y profesional. Sus herramientas me brindaron total seguridad en mí mismo.',
        name: 'Mateo Silva',
        job: 'Estudiante Universitario',
        image: {
          src: 'https://images.unsplash.com/photo-1512361436605-a484bdb34b5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Sidney Hansen Image',
        },
      },
    ]}
    callToAction={{
      text: 'Leer más testimonios',
      href: 'testimonios',
      icon: 'tabler:chevron-right',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-canvas-white dark:bg-transparent"></div>
    </Fragment>
  </Testimonials>

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Antes de iniciar, es normal querer claridad. Aquí tienes respuestas directas:"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿En qué se diferencia este programa de una terapia convencional o un curso online?',
        description:
          'No es contenido grabado ni terapia indefinida. Es un proceso estructurado de 12 semanas enfocado en cambio práctico, profundo y medible.',
      },
      {
        title: '¿Cómo sé si es para mí?',
        description:
          'Puedes agendar una consulta gratuita de 10 minutos. Revisamos tu caso y te diré con honestidad si este proceso encaja contigo o no.',
      },
      {
        title: '¿Qué es PNL, EFT e hipnosis?',
        description:
          'PNL reestructura pensamientos, EFT regula carga emocional en el cuerpo y la hipnosis facilita la instalación de nuevos patrones mentales.',
      },
      {
        title: '¿Quién es Angie Wong?',
        description:
          'Soy Psicóloga Colegiada (CPP. 14690) con más de 18 years de experiencia clínica y académica. Integro psicología, neurociencia y herramientas de regulación emocional.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Reservar consulta gratis',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20el%20programa%20de%2012%20semanas.',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    title="El cambio empieza con claridad, no con más información."
    subtitle="Reserva tu consulta gratuita de 10 minutos."
  />
</Layout>
