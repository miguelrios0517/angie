      {
        variant: 'primary',
        text: 'Agenda Una Consulta',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Conoce Mis Servicios', href: '#servicios' },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/angiewong2.jpeg',
      alt: 'Click-through Landing Page Hero Image',
    }}
  />

  <!-- Note Widget ******************* -->

  <Note
    title="Angie Wong:"
    description="Psicóloga · Coach · Especialista en PNL | 18+ años de experiencia"
    backgroundColor="section-background-dark "
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Psicoterapia Desde Donde Estés"
    subtitle="Sesiones por videollamada, con la comodidad y flexibilidad de recibir acompañamiento desde cualquier lugar."
    tagline="Un ESpacio Para Ti"
    items={[
      {
        title: 'Un espacio seguro y personalizado',
        description:
          'Habla con libertad en un ambiente de respeto, escucha y confidencialidad. Cada proceso se adapta a tu historia, necesidades y objetivos.',
        icon: 'tabler:brain',
      },
      {
        title: 'Acompañamiento profesional',
        description:
          'Obtén herramientas para comprender tus emociones, afrontar dificultades y generar cambios positivos.',
        icon: 'tabler:wave-sine',
      },
      {
        title: 'Consulta Inicial Gratuita • 10 min',
        description:
          'Una breve llamada para conocernos, escuchar qué estás buscando y orientarte sobre cómo puedo acompañarte.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-whatsapp',
        callToAction: {
          target: '_blank',
          text: 'WhatsApp',
          href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        },
      },
      {
        icon: 'tabler:brand-instagram',
        callToAction: {
          target: '_blank',
          text: 'Instagram',
          href: 'https://www.instagram.com/psic.angiewong?igsh=cmNtcDV4d3Buc3Fz',
        },
      },
