---
import Layout from '~/layouts/PageLayoutAngie.astro';

import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

const metadata = {
  title: 'Angie Wong - Psicologa, Coach y PNL',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <!-- <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AstroWind Hero Image' }}
  >
    <Fragment slot="title">
      Free template for <span class="hidden xl:inline">creating websites with</span>
      <span class="text-accent dark:text-white"> Astro v6</span> + Tailwind CSS
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">AstroWind</span> is a free, customizable and production-ready template for Astro v6 +
        Tailwind CSS v4.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">AstroWind: Production-ready.</span>
      Suitable for Startups, Small Business, SaaS websites, Professional Portfolios, Marketing websites, Landing Pages & Blogs.
    </Fragment>
  </Hero> -->

  <Hero2
    tagline="Recupera tu calma mental"
    title="Psicoterapia 100% Online para tu Bienestar"
    subtitle="Psicoterapia para personas de habla hispana desde cualquier parte del mundo. Un espacio profesional y confidencial para comprender lo que vives, gestionar tus emociones y avanzar con claridad."
    actions={[
      {
        variant: 'primary',
        text: 'Agenda tu Sesión',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Conoce el Programa', href: '#servicios' },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/angiewong2.jpeg',
      alt: 'Click-through Landing Page Hero Image',
    }}
  />

  <!-- Note Widget ******************* -->

  <Note
    title="Angie Wong:"
    description="Psicóloga · Coach · Especialista en PNL | 18+ años de experiencia"
    backgroundColor="section-background-dark "
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Un Espacio Pensado para Ti"
    subtitle="Cada persona vive sus procesos de manera diferente. Por eso, te acompaño con un enfoque profesional y personalizado, adaptando las herramientas a tu historia, tus necesidades y tus objetivos."
    tagline="Tu Bienestar, a Tu Manera"
    items={[
      {
        title: 'Psicoterapia 100% Online y Flexible',
        description:
          'Recibe acompañamiento desde cualquier parte del mundo, sin traslados y con sesiones que se adaptan a tu rutina, disponibilidad y zona horaria.',
        icon: 'tabler:brain',
      },
      {
        title: 'Un Enfoque Integral y Personalizado',
        description:
          'Integro Psicología Clínica, Coaching Mental y PNL para comprender cada proceso desde diferentes perspectivas y ofrecerte herramientas prácticas que puedas llevar a tu día a día.',
        icon: 'tabler:wave-sine',
      },
      {
        title: 'Consulta Inicial Gratuita • 10 min',
        description:
          'Conoce mi forma de trabajar, cuéntame qué estás buscando y resuelve tus dudas en una consulta inicial de 10 minutos, antes de decidir si este proceso es para ti.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-whatsapp',
        callToAction: {
          target: '_blank',
          text: 'WhatsApp',
          href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        },
      },
      {
        icon: 'tabler:brand-instagram',
        callToAction: {
          target: '_blank',
          text: 'Instagram',
          href: 'https://www.instagram.com/psic.angiewong?igsh=cmNtcDV4d3Buc3Fz',
        },
      },
      {
        icon: 'tabler:brand-tiktok',
        callToAction: {
          target: '_blank',
          text: 'TikTok',
          href: 'https://www.tiktok.com/@psico.angiewong?_r=1&_t=ZT-977uMlhAWhZ',
        },
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/angiewong4.jpeg',
      alt: 'Colorful Image',
      loading: 'eager',
      position: 'top',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-primary-navy text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Conoce a Angie Wong
      </h2>
      <p class="text-charcoal">
        Hola, soy Angie Wong. Creo un espacio seguro, confidencial y sin juicios donde puedas sentirte escuchada/o,
        comprender mejor lo que estás viviendo y encontrar nuevas formas de afrontar aquello que hoy te preocupa.
      </p>
      <br />

      <p class="text-charcoal">
        <strong
          >Si el estrés, el sobrepensamiento, la inseguridad o los cambios de la vida están afectando tu bienestar, no
          tienes que atravesarlos a solas.</strong
        >
      </p>
      <br />
      <p class="text-charcoal">
        Integro Psicología Clínica, Coaching y PNL para ayudarte a comprender tus emociones, transformar patrones y
        desarrollar herramientas prácticas que te permitan avanzar con mayor claridad y confianza.
      </p>
      <p class="text-charcoal">Demos el primer paso juntas/os hoy.</p>

      <br />
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-canvas-white dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Cómo te puedo ayudar"
    id="servicios"
    title="Cómo Podemos Trabajar Juntos"
    classes={{ container: 'services' }}
    items={[
      {
        title: '100% Online y Flexible',
        description:
          'Conéctate desde casa, tu oficina o cualquier espacio privado, con horarios que se adaptan a tu rutina y disponibilidad.',
      },
      {
        title: 'Sesiones individuales o de pareja',
        description: 'Elige la modalidad que mejor se adapte a tus necesidades y a lo que quieres trabajar.',
      },
      {
        title: 'Un espacio seguro y confidencial',
        description:
          'Habla con libertad en un entorno profesional, respetuoso y sin juicios, donde puedas sentirte escuchado/a y acompañado/a.',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/individual_cropped.jpg',
      alt: 'Sesión individual con Angie Wong',
    }}
    callToAction={{
      text: 'Más información',
      icon: 'tabler:chevron-right',
      href: 'sesion-individual',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-primary-navy text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Sesión Individual/Pareja (50 min virtual)
      </h3>
      Un espacio de psicoterapia para trabajar aquello que estás viviendo, desde la comodidad de tu propio espacio.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </Content>
  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Un proceso guiado de principio a fin',
        description: 'Avanza con apoyo y seguimiento a lo largo de las 12 semanas.',
      },
      {
        title: 'Objetivos y sesiones definidos',
        description: 'Trabaja con una estructura clara y objetivos concretos.',
      },
      {
        title: 'Herramientas para seguir avanzando',
        description: 'Desarrolla recursos prácticos que puedas aplicar en tu día a día.',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/hiking_cropped.jpg',
      alt: 'Blueprint Image',
    }}
    callToAction={{
      text: 'Más información',
      icon: 'tabler:chevron-right',
      href: 'programa-12-semanas',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-primary-navy text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Programa de Transformación (12 Semanas)
      </h3>
      Si buscas más que una sesión de 50 minutos, este programa te acompaña durante 3 meses con un proceso profundo y estructurado.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    classes={{
      wrapper: 'section-background-gray',
    }}
    isAfterContent
    items={[
      {
        title: 'Aprendizaje y crecimiento en comunidad',
        description: 'Comparte experiencias y aprende junto a otras personas.',
      },
      {
        title: 'Talleres para empresas y organizaciones',
        description: 'Promueve el bienestar emocional dentro de tu equipo.',
      },
      {
        title: 'Contenidos adaptados a cada grupo',
        description: 'Temas y dinámicas según las necesidades de cada organización.',
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/group.jpg',
      alt: 'Astronauts Image',
    }}
    callToAction={{
      text: 'Más información',
      icon: 'tabler:chevron-right',
      href: 'talleres-grupos',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-primary-navy text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Talleres y Sesiones Grupales
      </h3>
      Espacios grupales para aprender, crecer y desarrollar nuevas herramientas para tu bienestar.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Historias de Personas que Recuperaron su Bienestar"
    testimonials={[
      {
        testimonial: `El proceso con Angie ha sido transformador. Sus herramientas prácticas de PNL realmente me ayudaron a superar la tensión constante que afectaba mi día a día. Ahora me siento empoderada y capaz de manejar los desafíos de una manera muy saludable.`,
        name: 'Valeria Mendoza',
        job: 'Mentees Satisfecha',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Cary Kennedy Image',
        },
      },
      {
        testimonial: `Como coach, Angie me guio a través de un process de autorreflexión que cambió mi perspectiva y me dio el impulso necesario para avanzar en mi carrera. Su apoyo fue fundamental para alcanzar mis metas profesionales.`,
        name: 'Carlos Espinoza',
        job: 'Cliente Profesional',
        image: {
          src: 'https://images.unsplash.com/flagged/photo-1570612861542-284f4c12e75f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Josh Wilkinson Image',
        },
      },
      {
        testimonial:
          'Gracias a las sesiones de claridad y enfoque con Angie, finalmente pude tomar decisiones informadas sobre mi futuro académico y profesional. Sus herramientas me brindaron total seguridad en mí mismo.',
        name: 'Mateo Silva',
        job: 'Estudiante Universitario',
        image: {
          src: 'https://images.unsplash.com/photo-1512361436605-a484bdb34b5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Sidney Hansen Image',
        },
      },
    ]}
    callToAction={{
      text: 'Leer más testimonios',
      href: 'testimonios',
      icon: 'tabler:chevron-right',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-canvas-white dark:bg-transparent"></div>
    </Fragment>
  </Testimonials>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Respuestas a las dudas más frecuentes sobre las sesiones y el proceso terapéutico."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿En qué consiste la consulta gratuita?',
        description:
          'Es un espacio breve de 10 minutos para conocernos. Me contarás qué estás buscando, resolveré tus dudas y evaluaremos juntos el plan de cuidado ideal para ti.',
      },
      {
        title: '¿Cuántas sesiones voy a necesitar?',
        description:
          'Dependerá de tu motivo de consulta, metas y proceso personal. La terapia es un espacio flexible que se adapta de forma completamente personalizada a tus necesidades, ritmo y avances.',
      },
      {
        title: '¿Con qué enfoque terapéutico trabajas?',
        description:
          'Trabajo desde las Terapias Contextuales e integro herramientas prácticas de PNL para ayudarte a transformar patrones de pensamiento, gestionar emociones y construir una vida prima.',
      },
      {
        title: '¿Cómo sé si necesito una sesión individual o el programa de 12 semanas?',
        description:
          'La sesión individual alivia temas puntuales, y de forma recurrente ofrece un proceso profundo similar al programa de 12 semanas, el cual está diseñado si buscas una estructura paso a paso desde el inicio.',
      },
      {
        title: '¿Las sesiones virtuales son igual de efectivas que las presenciales?',
        description:
          'Sí, totalmente. Ofrecen la misma efectividad, confidencialidad y calidez que un encuentro presencial, con la ventaja de tomar la sesión desde la comodidad de tu casa y sin trasladarte.',
      },
      {
        title: '¿Puedo tomar terapia desde cualquier país?',
        description:
          'Sí, mi consulta es 100% online para personas hispanohablantes de diversos países. Solo necesitas conexión estable a internet, un dispositivo con cámara y un espacio privado y tranquilo.',
      },
      {
        title: '¿Qué plataforma usamos para las sesiones?',
        description:
          'Las sesiones se realizan de forma segura por Zoom. Tras confirmar el pago y la reserva de tu cita, recibirás el enlace de acceso directo y todos los detalles correspondientes por WhatsApp.',
      },
      {
        title: '¿Cuál es la política de cancelación o reprogramación?',
        description:
          'Puedes reprogramar tu cita con un mínimo de 24 horas de anticipación a la hora pactada. Recuerda que la nueva fecha asignada estará completamente sujeta a la disponibilidad actual de la agenda.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Clientes', amount: '1000+' },
      { title: 'Talleres', amount: '200+' },
      { title: 'Experiencia', amount: '18+' },
      { title: 'Estrellas', amount: '5' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-canvas-white dark:bg-transparent"></div>
    </Fragment>
  </Stats>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'custom',
        text: 'Agenda tu Consulta Gratuita',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">Empieza tu Camino hacia el Bienestar</Fragment>

    <Fragment slot="subtitle">
      No tienes que seguir enfrentándolo sola/o.<br class="hidden md:inline" />Agenda una consulta gratuita de 10
      minutos y descubre cómo empezar a recuperar tu calma, claridad y bienestar emocional.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-canvas-white dark:bg-transparent"></div>
    </Fragment>
  </CallToAction>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Recursos para tu Bienestar Emocional"
    information={`Artículos con herramientas prácticas, ejercicios y reflexiones para acompañar tu proceso de crecimiento personal.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
