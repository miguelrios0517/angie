---
import Layout from '~/layouts/PageLayoutAngie.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Personal Homepage Demo',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Angie Wong"
    tagline="Sobre Angie"
    actions={[
      {
        variant: 'primary',
        text: 'Agendar Sesión Virtual',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
      },
    ]}
  >
    <Fragment slot="subtitle">
      Psicóloga Clínica, Coach Mental & Máster en PNL CPP. 14690. <br /><br />
      Brindo un enfoque integral, compasivo e innovador en salud mental. Integro herramientas adaptadas a la historia y necesidades
      únicas de cada persona, transformando la comprensión del pasado en cambios reales en identidad, hábitos y bienestar.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-whatsapp',
        callToAction: {
          target: '_blank',
          text: 'WhatsApp',
          href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        },
      },
      {
        icon: 'tabler:brand-instagram',
        callToAction: {
          target: '_blank',
          text: 'Instagram',
          href: 'https://www.instagram.com/psic.angiewong?igsh=cmNtcDV4d3Buc3Fz',
        },
      },
      {
        icon: 'tabler:brand-tiktok',
        callToAction: {
          target: '_blank',
          text: 'TikTok',
          href: 'https://www.tiktok.com/@psico.angiewong?_r=1&_t=ZT-977uMlhAWhZ',
        },
      },
    ]}
    image={{
      src: 'https://assets.angiewongpsi.com/angiewong.jpg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Perfil Profesional (Biografía Narrativa)
      </h2>
      <p>
        Soy Licenciada en Psicología y me especializo en acompañar a personas a superar desafíos emocionales y clínicos
        complejos, como ansiedad, depresión y trastornos de la personalidad.
      </p>
      <br />
      <p>
        Mi práctica integra la rigurosidad de la Psicología Clínica con el enfoque estratégico de la Programación
        Neurolingüística (PNL) y el Coaching. Cuento con maestrías en Psicología Clínica y de la Salud y en Terapia del
        Bienestar Emocional (Madrid, España), lo que me permite abordar la salud mental desde una mirada integral:
        mente, cuerpo y emociones.
      </p>
      <br />
      <p>
        Además de mi labor clínica, he sido docente universitaria por más de una década, experiencia que sostiene mi
        actualización constante y rigor profesional.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Trayectoria Académica"
    items={[
      {
        title: `Máster en Terapia del Bienestar Emocional<br /> <span class="font-normal">CEU Universidad San Pablo (Madrid, España)</span> <br /> <span class="text-sm font-normal">2020 - 2021</span>`,
        icon: 'tabler:school',
      },
      {
        title: `Maestría en Psicología Clínica y de la Salud<br /> <span class="font-normal">Universidad San Martín de Porres</span> <br /> <span class="text-sm font-normal">2008 - 2010</span>`,
        icon: 'tabler:school',
      },
      {
        title: `Licenciatura en Psicología y Humanidades<br /> <span class="font-normal">Universidad Femenina del Sagrado Corazón (UNIFE)</span> <br /> <span class="text-sm font-normal">2000 - 2006</span>`,
        icon: 'tabler:school',
      },
      {
        title: `Certificación Internacional en Coaching Neurológico<br /> <span class="font-normal">Jamming Consultoría</span> <br /> <span class="text-sm font-normal">2017</span>`,
        icon: 'tabler:school',
      },
      {
        title: `Certificación Internacional en Gestión de la Innovación<br /> <span class="font-normal">Latam Coaching Network</span> <br /> <span class="text-sm font-normal">2018</span>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Experiencia Clave"
    items={[
      {
        title:
          'Consultorio Particular <br /> <span class="font-normal">Consulta Personal, Lima</span> <br /> <span class="text-sm font-normal">2007 - Actualidad</span>',
        description: `Psicóloga Clínica y Coach especializada en adolescentes y adultos en manejo de estrés, crisis de pareja, ansiedad, depresión y trastornos de la conducta alimentaria (anorexia/bulimia).`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Docencia Universitaria <br /> <span class="font-normal">Universidad Continental y Alas Peruanas, Lima</span> <br /> <span class="text-sm font-normal">2008 - 2021</span>',
        description: `Docente de pregrado y programas virtuales en la Universidad Continental y la Universidad Alas Peruanas, en cursos como Psicología Clínica, Técnicas Psicoterapéuticas y Psicología de la Motivación.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Investigación y Desarrollo Social <br /> <span class="font-normal">Ministerio de Educación, Lima</span> <br /> <span class="text-sm font-normal">2008 - 2021</span>',
        description: `Evaluadora de proyectos educativos para el Ministerio de Educación y psicóloga investigadora de mercados en 360° Inteligencia de Mercados IBC.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Certificaciones & Habilidades Clave"
    subtitle="Integración de herramientas clínicas y estratégicas para una transformación profunda."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'EFT Tapping',
        description: 'Liberación emocional para procesar bloqueos internos y reducir la respuesta de estrés.',
      },
      {
        title: 'Programación Neurolingüística (PNL)',
        description: 'Reestructuración de patrones de pensamiento y optimización del diálogo interno.',
      },
      {
        title: 'Hipnosis Ericksoniana',
        description: 'Modificación de conductas arraigadas mediante acceso guiado al inconsciente.',
      },
      {
        title: 'Gestión de la Innovación',
        description: 'Enfoque metodológico moderno y ágil para desarrollar soluciones clínicas efectivas.',
      },
      {
        title: 'Coaching Neurológico',
        description: 'Potenciación de habilidades individuales para maximizar el rendimiento personal.',
      },
      {
        title: 'Consultoría en PNL',
        description: 'Diseño de estrategias personalizadas para superar creencias limitantes de forma eficiente.',
      },
      {
        title: 'Coaching Metódico',
        description: 'Acompañamiento enfocado en superar bloqueos y alcanzar metas concretas.',
      },
      {
        title: 'Enfoque Transpersonal',
        description: 'Integración de la sombra junguiana y arquetipos para profundizar la sanación de la identidad.',
      },
      {
        title: 'Time Line Therapy®',
        description: 'Desensibilización de eventos pasados para liberar cargas emocionales persistentes.',
      },
    ]}
  />

  <!-- PNL **************** -->

  <Content
    id="porfolio"
    title="Mi Metodología: ¿Cómo trabajo con la PNL?"
    subtitle="Un enfoque clínico y estratégico para transformar la comprensión del pasado en cambios medibles en identidad, hábitos y bienestar."
    isReversed
    image={{
      src: 'https://images.unsplash.com/photo-1658248165252-71e116af1b34?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=928&q=80',
      alt: 'Tech Design Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        El Concepto:<br /><span class="text-2xl">¿Qué es la PNL?</span>
      </h3>
      <p>
        Imagina la PNL como el manual de usuario de tu cerebro. Tu mente funciona como un software que se ha programado
        desde la infancia a partir de experiencias, miedos y entorno.<br /><br />
        La PNL es un conjunto de herramientas prácticas que permite auditar ese sistema, identificar patrones limitantes y
        reprogramar la mente para responder con calma, seguridad y claridad en lugar de reactividad automática.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Programación',
        description: 'Sustitución de patrones de ansiedad y autosabotaje por automatismos orientados al bienestar.',
      },
      {
        title: 'Neuro',
        description: 'Optimización del sistema nervioso y de la forma en que el cerebro procesa el estrés.',
      },
      {
        title: 'Lingüística',
        description: 'Reestructuración del lenguaje y del diálogo interno que condiciona las emociones.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1619983081563-430f63602796?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Art and Music Poster Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Los Componentes:<br /><span class="text-2xl">Los Pilares del Cambio</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Descodificación de Creencias',
        description:
          'Uso de Hipnosis Ericksoniana ligera (trance conversacional) para identificar y desactivar bloqueos inconscientes sin resistencia.',
      },
      {
        title: 'Edición Mental y Alivio Somático',
        description:
          'Combinación de PNL y EFT Tapping clínico para reorganizar recuerdos dolorosos, reducir el estrés fisiológico y liberar tensión corporal.',
      },
      {
        title: 'Anclajes de Alto Rendimiento',
        description:
          'Uso de hipnosis profunda para instalar disparadores internos que permiten acceder a estados de calma y enfoque cuando se necesita.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1664455340023-214c33a9d0bd?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Fashion e-commerce Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        La Aplicación: <br /><span class="text-2xl">Tres Ejes de Acción en Sesión</span>
      </h3>
      <p>Procesos diseñados para transformar la experiencia interna:</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Lo Que Dicen Mis Clientes"
    subtitle="Testimonios e historias reales de transformación, claridad y crecimiento personal."
    testimonials={[
      {
        testimonial: `Llegué al consultorio en piloto automático, con ansiedad constante que no me dejaba decidir. El enfoque de Angie con PNL y Tapping me dio herramientas reales. Hoy siento que recuperé el control de mi mente y mi vida.`,
        name: 'Marcos Torres',
        job: 'Emprendedor Digital',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Marcos Torres Image',
        },
      },
      {
        testimonial: `Buscaba herramientas prácticas, no solo hablar de mis problemas. Las sesiones de Hipnosis Ericksoniana me ayudaron a desbloquear patrones inconscientes que arrastraba desde hace años en mi carrera y relaciones. Totalmente medible.`,
        name: 'Emilia Martínez',
        job: 'Directora de Proyectos',
        image: {
          src: 'https://images.unsplash.com/photo-1554151228-14d9def656e4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=772&q=80',
          alt: 'Emilia Martínez Image',
        },
      },
      {
        testimonial: `Angie combina una gran empatía con una estructura clínica sólida. Su acompañamiento en estrés y burnout cambió mi forma de liderar y de cuidar mi salud mental.`,
        name: 'Laura Silva',
        job: 'Fundadora de ONG',
        image: {
          src: 'https://images.unsplash.com/photo-1554727242-741c14fa561c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Laura Silva Image',
        },
      },
      {
        testimonial: `El trabajo con Time Line Therapy® fue un antes y un después. Me permitió liberar cargas emocionales profundas del pasado de forma segura, compasiva y sin resistencia.`,
        name: 'Alejandro Fuentes',
        job: 'Consultor Independiente',
        image: {
          src: 'https://images.unsplash.com/photo-1599566150163-29194dcaad36?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Alejandro Fuentes Image',
        },
      },
      {
        testimonial: `Valoro que el espacio sea 100% confidencial, seguro y sin juicios. Al ser virtual, pude hacer mi proceso desde casa sin perder profundidad ni conexión.`,
        name: 'Jessica Collado',
        job: 'Diseñadora UX',
        image: {
          src: 'https://images.unsplash.com/photo-1548142813-c348350df52b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=778&q=80',
          alt: 'Jessica Collado Image',
        },
      },
      {
        testimonial: `Su enfoque integral mente-cuerpo-emociones realmente funciona. Aprendí a identificar mi diálogo interno negativo y reprogramarlo con PNL. Angie es una profesional excepcional.`,
        name: 'Miguel Castro',
        job: 'Coordinador de Operaciones',
        image: {
          src: 'https://images.unsplash.com/photo-1566492031773-4f4e44671857?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Miguel Castro Image',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Comienza tu proceso de cambio hoy"
    subtitle="Las consultas se realizan 100% online mediante plataformas seguras, garantizando confidencialidad y comodidad desde cualquier lugar."
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar Consulta Gratuita',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20solicitar%20la%20consulta%20gratuita%20de%2010%20minutos%20para%20conocer%20m%C3%A1s%20sobre%20las%20sesiones.',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    items={[
      {
        title: 'WhatsApp',
        description: '+51 987 717 886',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'angiewong.psicologa@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Locación',
        description: 'Lima, Perú',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
