---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayoutAngie.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Servicios',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Servicios"
    title="Talleres y Sesiones Grupales"
    subtitle="Procesos grupales de transformación: espacios guiados que generan cambios reales a través de la conexión y el aprendizaje compartido."
    actions={[{ variant: 'primary', text: 'Explorar servicio', href: '/talleres-grupos#intro' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Angie Wong Logo',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    id="intro"
    isReversed
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'AstroWind Hero Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Talleres y Sesiones Grupales</h3>
      <p>
        Espacios de crecimiento compartido, reflexión profunda y herramientas prácticas para potenciar el bienestar
        emocional, personal y profesional dentro de una comunidad.<br /><br />El desarrollo personal no tiene por qué
        vivirse en solitario. Los talleres y sesiones grupales crean un entorno donde el aprendizaje se multiplica
        gracias a la experiencia compartida, la resonancia con otros y el sostén de un espacio seguro, confidencial y
        facilitado por un profesional.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Validación',
        description:
          'Descubrir que otras personas viven inquietudes similares reduce el aislamiento y fortalece la autocompasión.',
        icon: 'tabler:clock',
      },
      {
        title: 'Perspectiva',
        description: 'Escuchar diferentes puntos de vista amplía las formas de comprender y afrontar las situaciones.',
        icon: 'tabler:school',
      },
      {
        title: 'Acción',
        description: 'El compromiso con el grupo impulsa la constancia y la aplicación real de lo aprendido.',
        icon: 'tabler:coin',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Features Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        ¿Por qué elegir el formato grupal?
      </h3>
      <p>
        A diferencia del trabajo individual, el grupo actúa como un espejo amplificado. Permite identificar patrones
        comunes, normalizar experiencias emocionales y aprender herramientas prácticas a través de dinámicas vivenciales
        e interactivas. Es un entorno ideal para fortalecer la comunicación, la resiliencia y el autoconocimiento.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Regulación Emocional y Mindfulness',
        description:
          'Herramientas prácticas para reconocer, comprender y gestionar el estrés y la ansiedad desde la atención plena.',
        icon: 'tabler:wand',
      },
      {
        title: 'Crecimiento Personal y Transiciones',
        description:
          'Espacios de claridad para momentos de cambio, revisión de creencias limitantes y diseño de metas alineadas con tu propósito.',
        icon: 'tabler:settings',
      },
      {
        title: 'Vínculos, Asertividad y Límite',
        description:
          'Sesiones enfocadas en mejorar la comunicación, construir relaciones más sanas y aprender a establecer límites claros sin culpa.',
        icon: 'tabler:presentation',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Benefits Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Nuestras Líneas de Trabajo</h3>
      <p>Abordamos el bienestar emocional y el crecimiento personal a través de tres ejes fundamentales:</p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    items={[
      {
        title: 'Encuadre Conceptual',
        description: 'Introducción breve y clara para comprender el sentido del trabajo que realizamos.',
        icon: 'tabler:wand',
      },
      {
        title: 'Dinámicas Experienciales',
        description: 'Ejercicios prácticos e interactivos para integrar el contenido de forma vivencial.',
        icon: 'tabler:settings',
      },
      {
        title: 'Espacio de Co-reflexión',
        description:
          'Puesta en común voluntaria para compartir, resolver dudas y procesar la experiencia con acompañamiento profesional.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Herramientas de Integración',
        description: 'Recursos y guías prácticas para seguir aplicando lo aprendido durante la semana.',
        icon: 'tabler:presentation',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Features Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Metodología de Trabajo</h3>
      <p>
        Cada taller o ciclo grupal se basa en un marco teórico sólido (Psicología Cognitivo-Conductual, enfoque
        Humanista y Coaching), presentado de forma clara, práctica y accesible. Los encuentros se estructuran en cuatro
        momentos:
      </p>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Lo que dicen quienes ya han dado el paso"
    testimonials={[
      {
        testimonial: `El proceso con Angie ha sido transformador. Sus herramientas prácticas de PNL realmente me ayudaron a superar la tensión constante que afectaba mi día a día. Ahora me siento empoderada y capaz de manejar los desafíos de una manera muy saludable.`,
        name: 'Valeria Mendoza',
        job: 'Mentees Satisfecha',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Cary Kennedy Image',
        },
      },
      {
        testimonial: `Como coach, Angie me guio a través de un process de autorreflexión que cambió mi perspectiva y me dio el impulso necesario para avanzar en mi carrera. Su apoyo fue fundamental para alcanzar mis metas profesionales.`,
        name: 'Carlos Espinoza',
        job: 'Cliente Profesional',
        image: {
          src: 'https://images.unsplash.com/flagged/photo-1570612861542-284f4c12e75f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Josh Wilkinson Image',
        },
      },
      {
        testimonial:
          'Gracias a las sesiones de claridad y enfoque con Angie, finalmente pude tomar decisiones informadas sobre mi futuro académico y profesional. Sus herramientas me brindaron total seguridad en mí mismo.',
        name: 'Mateo Silva',
        job: 'Estudiante Universitario',
        image: {
          src: 'https://images.unsplash.com/photo-1512361436605-a484bdb34b5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Sidney Hansen Image',
        },
      },
    ]}
    callToAction={{
      text: 'Leer más testimonios',
      href: 'testimonios',
      icon: 'tabler:chevron-right',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-canvas-white dark:bg-transparent"></div>
    </Fragment>
  </Testimonials>
  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Respuestas claras y directas a las dudas más comunes sobre los espacios grupales."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Cómo sé si es mejor un proceso individual o grupal?',
        description:
          'El formato grupal es ideal para adquirir herramientas y compartir experiencias. Si buscas trabajar un tema muy específico o clínicamente complejo, el proceso individual puede ser más adecuado. Ambos formatos pueden complementarse.',
      },
      {
        title: 'Me da timidez hablar en grupo, ¿es obligatorio participar?',
        description:
          'No. El respeto por tu ritmo es esencial. Compartir es siempre voluntario. Puedes beneficiarte escuchando y participando solo cuando te sientas listo/a.',
      },
      {
        title: '¿Cuál es el perfil de la persona que facilita estos espacios?',
        description:
          'Los espacios son guiados por Angie Wong, quien integra la base científica de la psicología con un enfoque práctico orientado al crecimiento personal y al coaching estratégico.',
      },
      {
        title: '¿Cuántas personas forman cada grupo?',
        description:
          'Para asegurar un espacio seguro y de calidad, los grupos son reducidos, con un máximo de 10 a 12 participantes por ciclo.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-mist-grey dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Consultar próximos talleres',
        target: '_blank',
        href: 'https://wa.me/51987717886?text=Hola%20Psic.%20Angie%2C%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20pr%C3%B3ximos%20grupos%20y%20talleres.',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    title="¿Te interesa participar en el próximo espacio grupal?"
    subtitle="Si quieres conocer las temáticas disponibles, próximas fechas o llevar estos talleres a tu organización, contáctanos para recibir información actualizada."
  />
</Layout>
